# Based on https://github.com/nix-community/home-manager#nix-flakes
{
  description = "Home Manager flake";

  inputs = {
    nixpkgs.url = "github:NixOS/nixpkgs/nixos-26.05";
    nixpkgs-py38.url = "github:NixOS/nixpkgs/nixos-23.11";
    nix-darwin.url = "github:nix-darwin/nix-darwin/nix-darwin-26.05";
    nix-darwin.inputs.nixpkgs.follows = "nixpkgs";
    home-manager.url = "github:nix-community/home-manager/release-26.05";
    home-manager.inputs.nixpkgs.follows = "nixpkgs";
  };

  outputs = { nixpkgs, nixpkgs-py38, nix-darwin, home-manager, ... } @ inputs:
    let
      pkgs = import nixpkgs {
        system = "aarch64-darwin";
        overlays = [
          (final: prev: {
            # python38 was removed from nixpkgs; take it from 23.11
            python38 = let
              dir = "${nixpkgs-py38}/pkgs/development/interpreters/python";
            in final.callPackage "${dir}/cpython" {
              self = final.python38;
              sourceVersion = { major = "3"; minor = "8"; patch = "19"; suffix = ""; };
              hash = "sha256-0oB6xp9puE/UaguTu9AqT6SNPnD0soNf8PcqKIUEAHY=";
              configd = final.emptyDirectory;
              passthruFun = import "${dir}/passthrufun.nix" {
                inherit (final) __splicedPackages callPackage config darwin db lib libffiBoot makeScopeWithSplicing' pythonPackagesExtensions stdenv;
              };
            };

            nix = prev.nix.overrideAttrs (_: {
              doCheck = false;
              doInstallCheck = false;
            });

            nodejs-slim_24 = prev.nodejs-slim_24.overrideAttrs (_: {
              doCheck = false;
              doInstallCheck = false;
            });

            nodejs_24 = prev.nodejs_24.overrideAttrs (_: {
              doCheck = false;
              doInstallCheck = false;
            });

            pythonPackagesExtensions = prev.pythonPackagesExtensions ++ [
              (pyFinal: pyPrev: {
                uvloop = pyPrev.uvloop.overridePythonAttrs (_: {
                  doCheck = false;
                });
                twisted = pyPrev.twisted.overridePythonAttrs (_: {
                  doCheck = false;
                  doInstallCheck = false;
                });

              })
            ];
          })
        ];
      };
    in {
      darwinConfigurations."HOSTNAME" = nix-darwin.lib.darwinSystem {
        inherit pkgs;
        modules = [ ./darwin-configuration.nix ];
      };

      homeConfigurations = {
        rlmbp2025 = home-manager.lib.homeManagerConfiguration {
          inherit pkgs;
          modules = [
            ./home-manager/modules/home-manager.nix
            ./home-manager/modules/common.nix
            ./home-manager/modules/git.nix
            ./home-manager/modules/ssh.nix
            ./home-manager/modules/zsh.nix
            ./home-manager/mac.nix
            ./home-manager/postgres_pytest.nix
            {
              home = {
                username = "USERNAME";
                homeDirectory = "/Users/USERNAME";
                stateVersion = "26.05";
              };
            }
          ];
        };
      };
    };
}
